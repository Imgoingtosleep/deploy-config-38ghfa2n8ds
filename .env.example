# ==========================================
# Network Automation Server Configuration (Example)
# ==========================================

# Port Configuration
FRONTEND_PORT=4000
BACKEND_PORT=4050

# Backend API Configuration
BACKEND_HOST=0.0.0.0
VITE_API_BASE_URL=http://localhost:4050

# Network Device SSH Default Settings
DEFAULT_DEVICE_TYPE=cisco_ios
DEFAULT_SSH_PORT=22
DEFAULT_TIMEOUT=30
GLOBAL_DELAY_FACTOR=1

# Security / App Keys
SECRET_KEY=change-this-to-a-secure-random-key
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# Scheduled Deploy
DEPLOY_LOG_DIR=logs/deploy
DEPLOY_SCHEDULE_TICK_SECONDS=15
DEPLOY_SCHEDULE_GRACE_MINUTES=15
