# Port Configuration
FRONTEND_PORT=4000
BACKEND_PORT=4050

# Backend API Configuration
BACKEND_HOST=0.0.0.0
# The Vite proxy needs to hit the main server through Nginx
VITE_API_BASE_URL=/deploy-config/8200
ROOT_PATH=/deploy-config/8200

# Device Settings
DEFAULT_DEVICE_TYPE=huawei
DEFAULT_SSH_PORT=22
DEFAULT_TIMEOUT=30  
GLOBAL_DELAY_FACTOR=1

# Security / App Keys
SECRET_KEY=supersecret-network-automation-key-change-me
ENVIRONMENT=production
ALLOWED_ORIGINS=*

# SSO Settings
SINGLE_VIEW_API_URL=http://10.1.10.200
USE_REAL_SSO=true
